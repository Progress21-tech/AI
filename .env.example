NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Use the anon/public key for browser-safe access.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Backwards-compatible alias used by older code paths.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_anon_key

# Set this to ProbeTech's canonical HTTPS website origin when confirmed.
NEXT_PUBLIC_SITE_URL=

# Server-only credentials. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

GEMINI_API_KEY=your_gemini_key
AI_MODEL=gemini-2.5-flash

# Server-only values for discovery-call persistence and email delivery.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=ProbeTech <calls@your-verified-domain.com>
OWNER_NOTIFICATION_EMAIL=you@your-domain.com
CRON_SECRET=generate-a-long-random-secret
